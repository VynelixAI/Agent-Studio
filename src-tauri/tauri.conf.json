{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Studio",
  "version": "0.1.0",
  "identifier": "ai.vynelix.agentstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Studio — VynelixAI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": [
      "resources/agent-studio.yaml.example",
      "resources/server/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerHooks": "./installer/windows-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "curl"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "curl"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
