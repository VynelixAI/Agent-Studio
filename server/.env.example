# Local development defaults (API listens only on this computer)
PORT=8787
API_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vynelix_agent_studio

# 32+ character high-entropy key. Generate with: openssl rand -hex 32
# For remote production, this is required. Never commit a real key.
SECRETS_KEY=
RUNS_ROOT=../data/runs

# Explicit UI origins; avoid wildcard CORS.
CORS_ORIGIN=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Local development only. For any network-exposed deployment set NODE_ENV=production,
# API_HOST=0.0.0.0, AUTH_REQUIRED=true, API_KEYS and a strong SECRETS_KEY.
NODE_ENV=development
AUTH_REQUIRED=false
# Format: key:role,key2:role2  roles=admin|operator|viewer
# Each key must be a random value >=32 characters. Generate with: openssl rand -hex 32
API_KEYS=
# Optional connector environment variables to pass into workflow child processes.
# Prefer secret:// references where possible. Never allow-list backend core secrets.
RUNNER_ENV_ALLOWLIST=
DATA_RESIDENCY=IN
AUDIT_RETENTION_DAYS=365
RUN_RETENTION_DAYS=90
PRIVACY_CONTACT=privacy@vynelixai.com
SECURITY_CONTACT=security@vynelixai.com
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Local trusted workflows may use the host Python runtime. Any network-exposed API
# must use the Docker runner and must have Docker installed with the image built.
RUNNER_SANDBOX=local
RUNNER_DOCKER_IMAGE=agent-studio-runner:local
# Default no network; use a custom egress-restricted Docker network only when required.
RUNNER_DOCKER_NETWORK=none
RUNNER_MEMORY_MB=1024
RUNNER_CPU_LIMIT=1
RUNNER_PIDS_LIMIT=128
