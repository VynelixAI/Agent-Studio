PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vynelix_agent_studio
# 32+ char key used to encrypt connector secrets at rest (AES-256-GCM)
SECRETS_KEY=
RUNS_ROOT=../data/runs
# * = allow Studio UI from any host (needed when opening http://<server-ip>:1420)
# Or list origins: http://localhost:1420,http://10.0.0.5:1420
CORS_ORIGIN=*

# --- US + India security ---
NODE_ENV=development
# Set true in production (NIST / SOC2 / DPDP access control)
AUTH_REQUIRED=false
# Format: key:role,key2:role2  roles=admin|operator|viewer
API_KEYS=
# Default data residency for workspaces (IN | US | EU | GLOBAL)
DATA_RESIDENCY=IN
AUDIT_RETENTION_DAYS=365
RUN_RETENTION_DAYS=90
PRIVACY_CONTACT=privacy@vynelixai.com
SECURITY_CONTACT=security@vynelixai.com
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
