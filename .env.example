# Frontend API target for local development. Leave unset to use the default localhost API.
VITE_API_URL=http://localhost:8787

# Remote/LAN deployments must explicitly configure the backend with API_HOST=0.0.0.0,
# NODE_ENV=production, AUTH_REQUIRED=true, API_KEYS, a strong SECRETS_KEY, and an exact
# CORS_ORIGIN allow-list. Do not expose the API without authentication.
